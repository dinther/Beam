{
  "name": "lightyard",
  "author": "Paul van Dinther",
  "version": "0.1.0-alpha.1",
  "private": true,
  "main": "./out/main/main.js",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore --fix src",
    "electron:start": " electron-vite dev",
    "electron:build": " electron-vite build",
    "dist:linux": "npm run electron:build && cross-env TARGET_PLATFORM=linux TARGET_ARCH=arm64 electron-builder --linux --config ./src/electron/electron-builder.yml",
    "dist:mac": "npm run electron:build && cross-env TARGET_PLATFORM=darwin TARGET_ARCH=arm64 electron-builder --mac --config ./src/electron/electron-builder.yml",
    "dist:win": "npm run electron:build && cross-env TARGET_PLATFORM=win32 TARGET_ARCH=x64 electron-builder --win --config ./src/electron/electron-builder.yml"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@vue/compat": "^3.3.0",
    "axios": "^0.26.1",
    "events": "^3.3.0",
    "lodash": "^4.17.21",
    "mitt": "^3.0.1",
    "postprocessing": "^6.36.4",
    "stats.js": "^0.17.0",
    "three": "^0.170.0",
    "three-orbitcontrols": "^2.110.3",
    "vue": "^3.2.36",
    "vue-router": "^4.2.5",
    "webrtc-adapter": "^9.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.18.6",
    "@babel/eslint-parser": "^7.12.16",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/compiler-sfc": "^3.3.4",
    "cross-env": "^10.1.0",
    "electron": "^41.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-vue": "^9.19.2",
    "vite": "^5.0.10",
    "vite-svg-loader": "^5.1.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions"
  ],
  "build": {
    "asar": true,
    "npmRebuild": true,
    "extraResources": [
      {
        "from": "./public/",
        "to": "public",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "release": {
    "branches": [
      "master",
      {
        "name": "staging",
        "prerelease": "rc"
      }
    ],
    "dryRun": false,
    "ci": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successComment": false,
          "failComment": false,
          "failTitle": false,
          "labels": false,
          "releasedLabels": false
        }
      ]
    ]
  }
}
